class Solution:
    def restoreIpAddresses(self, s: str) -> list[str]:
        res = []
        
        # Early exit if the string cannot possibly form a valid IP address
        if len(s) < 4 or len(s) > 12:
            return res

        def backtrack(start: int, path: list[str]):
            # Base case: if we have 4 segments and reached the end of the string
            if len(path) == 4:
                if start == len(s):
                    res.append(".".join(path))
                return
            
            # Explore segments of lengths 1, 2, and 3
            for length in range(1, 4):
                if start + length > len(s):
                    break
                    
                segment = s[start:start+length]
                
                # Check for invalid leading zeros (e.g., "01", "001")
                if len(segment) > 1 and segment[0] == '0':
                    continue
            
             
        return res
